{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schaumburg-liquors-card",
  "main": "worker.mjs",
  "account_id": "c87ce33af5e41a495ad649318a8a2468",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/schaumburg-liquors", "/schaumburg-liquors/*", "/api/*"]
  }
}
