PORT=3000
# Set the permanent HTTPS origin before printing QR codes or deploying.
PUBLIC_URL=http://localhost:3000
# Exact owner-supplied Google review URL; leave blank until verified.
GOOGLE_REVIEW_URL=
WEBSITE_URL=
# Server only. The provider must support Chat Completions with JSON output.
OPENAI_API_KEY=
AI_MODEL=
AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Hostinger runtime: HOST=0.0.0.0 and PUBLIC_URL=https://connect.schaumburgliquor.com
HOST=127.0.0.1
